# انسخ هذا الملف إلى .env وضع فيه التوكن الفعلي (لا ترفع .env على أي مكان عام)
SALLA_ACCESS_TOKEN=ضع_التوكن_هنا

# اختياري: عدد الطلبات في كل صفحة عند الجلب من سلة (30 هو الحد الأقصى الموصى به)
PER_PAGE=30

# منفذ التشغيل (Replit يضبطه تلقائيًا عادة، اتركه كما هو)
PORT=3000

# بيانات الدخول لحماية الموقع بالكامل - غيّرها لأي اسم مستخدم وكلمة مرور تريدها
SITE_USERNAME=admin
SITE_PASSWORD=غيّر_هذي_لكلمة_مرور_قوية
